{
  "manifest_version": 3,
  "name": "Clawd for your browser",
  "short_name": "Clawd",
  "version": "0.1.0",
  "description": "Lets the Clawd desktop companion read whole pages when you ask him to (e.g. \"summarize this page\"). Talks only to Clawd on this PC.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Clawd", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "minimum_chrome_version": "116"
}
