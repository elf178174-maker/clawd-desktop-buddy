{
  "name": "clawd-companion",
  "productName": "Clawd",
  "version": "0.1.0",
  "description": "Clawd: a pixel-art desktop companion with its own AI agent (fan-made, not affiliated with Anthropic)",
  "main": "./out/main/index.js",
  "author": "Computerbror",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elf178174-maker/clawd-desktop-buddy.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:native && electron-vite build",
    "build:native": "node scripts/build-native.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "models": "node scripts/fetch-models.mjs",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "sherpa-onnx-node": "^2.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "docx": "^9.14.0",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
